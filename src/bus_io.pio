.define GATES_BLOCK_ALL 0b1111
.define GATES_READ_LOW_ADDR 0b1110
.define GATES_READ_HIGH_ADDR 0b1101
.define GATES_READ_DATA 0b1011
.define GATES_WRITE_DATA 0b0011

; Reads capture low and high address as two FIFO words, mirroring the write
; program. The low byte is pushed immediately so core1's dispatch (and the
; timing-critical EXWAIT assertion) is not delayed by the high capture. The
; high-address capture is decoupled from the data-gate direction reversal:
; the capture instruction parks the gates at BLOCK_ALL (break-before-make),
; and only the following instruction reverses the data gate toward the Z80
; bus (RD0 low), keeping all gate activity PIO-timed within ~75ns of IORQ.
.program bus_read_deluxe
.side_set 4 opt
.wrap_target
    nop                         side GATES_READ_LOW_ADDR
wait_iorq_low:
    wait 0 gpio 20
    jmp pin, wait_iorq_low
    in pins, 8                  side GATES_READ_HIGH_ADDR
    ; Settle: the 2-cycle input synchronizer eats short delays, so the loop
    ; must cover gate enable time (~40ns) plus that lag. 1 set + 8 loop cycles.
    set x, 7
high_settle_r:
    jmp x-- high_settle_r
    in pins, 8                  side GATES_BLOCK_ALL
    nop                         side GATES_WRITE_DATA
    ; End-of-cycle IORQ spike filter: a few-ns crosstalk spike (coupled from
    ; a gate edge into the IORQ input trace) can be latched by the 2-cycle
    ; input synchronizer and satisfy a single wait, wrapping the SM early -
    ; a ghost capture that slips the device position counters. The real IORQ
    ; high lasts hundreds of ns, so wait, outlast any spike (~90ns), then
    ; re-verify. Runs in the dead time between cycles: zero latency cost.
wait_iorq_high:
    wait 1 gpio 20
    set x, 15
spike_flt_r:
    jmp x-- spike_flt_r
    wait 1 gpio 20
.wrap

.program bus_read_frugal
.side_set 4 opt
.wrap_target
wait_iorq_low:
    wait 0 gpio 20
    jmp pin, wait_iorq_low
    in pins, 8
    wait 1 gpio 20
.wrap 

; One program, two state machines: SM_WRITE captures I/O writes (entry at
; io_entry, autopush 8 -> three FIFO words), and SM_SNOOP watches MZ-700
; memory-mapped peripheral writes (entry at mem_entry, autopush off -> one
; 24-bit packed word). /MREQ is not wired to the Pico, but a /WR falling
; edge with /IORQ still high identifies a memory write exactly (refresh
; and opcode fetches never assert /WR). Both SMs execute the shared
; capture tail with their own PC and their own wrap window; bus cycles
; are time-exclusive, so their gate side-sets never overlap.
.program bus_write_deluxe
.side_set 4 opt
public mem_entry:
mem_wait:
    wait 0 gpio 22              ; /WR falls
    jmp pin, capture            ; snoop SM maps jmp pin = IORQ: high -> memory write
    wait 1 gpio 22              ; I/O write - the write SM's business
    jmp mem_wait
public mem_done:                ; snoop SM wrap target (reached after the tail)
    ; One packed event word: (data<<24)|(high<<16)|(low<<8). Noblock: if
    ; the FIFO is full the event is dropped - the snoop SM must NEVER
    ; stall mid-dance or it parks the gates in the wrong state and
    ; corrupts subsequent I/O captures.
    push noblock
    nop                         side GATES_READ_LOW_ADDR
    wait 1 gpio 22              ; wait out the memory write
    jmp mem_wait
.wrap_target
public io_entry:
    nop                         side GATES_READ_LOW_ADDR
wait_iorq_low:
    wait 0 gpio 20
    jmp pin, wait_iorq_low
capture:
    in pins, 8                  side GATES_READ_HIGH_ADDR
    ; Let the high-address transceiver settle before sampling. The 2-cycle
    ; input synchronizer means the sample lags the pins, so the delay must
    ; cover gate enable time (~40ns) plus that lag. 1 set + 8 loop cycles.
    set x, 7
high_settle_w:
    jmp x-- high_settle_w
    in pins, 8                  side GATES_READ_DATA
    ; Capture the data byte as a third FIFO word once the data gate settles.
    ; The Z80 drives write data for the whole IORQ cycle, so this sample is
    ; timing-safe, and core1 no longer races the end of the cycle to read
    ; the bus for non-exwait ports.
    set x, 7
data_settle_w:
    jmp x-- data_settle_w
    in pins, 8
wait_iorq_high:
    wait 1 gpio 20              ; io: cycle end; mem: IORQ already high, falls through
.wrap

; Frugal writes capture address (GPIO 0-7) AND write data (GPIO 8-15) in a
; single 16-bit sample at /WR detection: the Z80 drives write data before
; /WR falls and holds it for the whole cycle, so the sample is timing-safe
; and core1 no longer races the end of the cycle with read_data_bus() -
; the same late-core1 immunity the Deluxe path gets from its third FIFO
; word. Still one FIFO word per write: the drain contract is unchanged.
.program bus_write_frugal
.side_set 4 opt
.wrap_target
wait_iorq_low:
    wait 0 gpio 20
    jmp pin, wait_iorq_low
    in pins, 16
wait_iorq_high:
    wait 1 gpio 20
.wrap

.program bus_reset
.wrap_target
start:
    wait 1 gpio 19
    set x, 30
hold_high:
    jmp pin, still_high
    jmp start
still_high:
    jmp x-- hold_high
    irq set 0
.wrap


% c-sdk {
#include "hardware/pio.h"
#include "bus_io.pio.h"

uint bus_read_deluxe_init(PIO pio, uint sm, uint base_gpio, uint jump_gpio) {
    pio_sm_claim(pio, sm);
    uint offset = pio_add_program(pio, &bus_read_deluxe_program);

    pio_sm_config c = bus_read_deluxe_program_get_default_config(offset);

    sm_config_set_in_pins(&c, base_gpio);
    sm_config_set_jmp_pin(&c, jump_gpio);
    sm_config_set_in_shift(&c, true, true, 8);
    sm_config_set_clkdiv(&c, 1.0f);
    sm_config_set_sideset_pins(&c, 8);
    // TX FIFO is unused; join it to RX for 8 words (4 transactions) of headroom
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    pio_sm_set_consecutive_pindirs(pio, sm, 8, 4, true);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
    return offset;
}

uint bus_read_frugal_init(PIO pio, uint sm, uint base_gpio, uint jump_gpio) {
    pio_sm_claim(pio, sm);
    uint offset = pio_add_program(pio, &bus_read_frugal_program);

    pio_sm_config c = bus_read_frugal_program_get_default_config(offset);

    sm_config_set_in_pins(&c, base_gpio);
    sm_config_set_jmp_pin(&c, jump_gpio);
    sm_config_set_in_shift(&c, true, true, 8);
    sm_config_set_clkdiv(&c, 1.0f);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
    return offset;
}

// Returns the program BASE offset. The I/O write SM starts at
// base + bus_write_deluxe_offset_io_entry (use that as the restart target,
// not the base - the base is the memory-snoop entry).
uint bus_write_deluxe_init(PIO pio, uint sm, uint base_gpio, uint jump_gpio) {
    pio_sm_claim(pio, sm);
    uint offset = pio_add_program(pio, &bus_write_deluxe_program);

    pio_sm_config c = bus_write_deluxe_program_get_default_config(offset);

    sm_config_set_in_pins(&c, base_gpio);
    sm_config_set_jmp_pin(&c, jump_gpio);
    sm_config_set_in_shift(&c, true, true, 8);
    sm_config_set_sideset_pins(&c, 8);
    pio_sm_set_consecutive_pindirs(pio, sm, 8, 4, true);
    sm_config_set_clkdiv(&c, 1.0f);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    pio_sm_init(pio, sm, offset + bus_write_deluxe_offset_io_entry, &c);
    pio_sm_set_enabled(pio, sm, true);
    return offset;
}

// MZ-700 memory-write snoop SM: same program, mem_entry entry point, own
// wrap window (tail end -> mem_done). jmp pin is IORQ here, autopush is
// off (24-bit packed event pushed explicitly with noblock).
void bus_mem_snoop_init(PIO pio, uint sm, uint base_gpio, uint write_prog_base) {
    pio_sm_claim(pio, sm);

    pio_sm_config c = bus_write_deluxe_program_get_default_config(write_prog_base);

    sm_config_set_in_pins(&c, base_gpio);
    sm_config_set_jmp_pin(&c, 20);           // IORQ
    sm_config_set_in_shift(&c, true, false, 32);
    sm_config_set_sideset_pins(&c, 8);
    sm_config_set_clkdiv(&c, 1.0f);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_wrap(&c,
        write_prog_base + bus_write_deluxe_offset_mem_done,
        write_prog_base + bus_write_deluxe_program.length - 1);
    pio_sm_set_consecutive_pindirs(pio, sm, 8, 4, true);
    pio_sm_init(pio, sm, write_prog_base + bus_write_deluxe_offset_mem_entry, &c);
    pio_sm_set_enabled(pio, sm, true);
}

uint bus_write_frugal_init(PIO pio, uint sm, uint base_gpio, uint jump_gpio) {
    pio_sm_claim(pio, sm);
    uint offset = pio_add_program(pio, &bus_write_frugal_program);

    pio_sm_config c = bus_write_frugal_program_get_default_config(offset);

    sm_config_set_in_pins(&c, base_gpio);
    sm_config_set_jmp_pin(&c, jump_gpio);
    // 16-bit autopush: address + data in one word (shift right, so the
    // sample lands in bits 31:16 - address at 23:16, data at 31:24)
    sm_config_set_in_shift(&c, true, true, 16);
    sm_config_set_clkdiv(&c, 1.0f);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
    return offset;
}

void bus_reset_init(PIO pio, uint sm) {
    // Reserve the requested state machine so other subsystems (e.g. SN76489 audio)
    // cannot steal SM0 on pio0 and break reset IRQ handling.
    pio_sm_claim(pio, sm);

    uint offset = pio_add_program(pio, &bus_reset_program);

    pio_sm_config c = bus_reset_program_get_default_config(offset);
    sm_config_set_jmp_pin(&c, 19);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
